# Maintainer: erdlabs <https://erdlabs.com>
# Contributor: see repository
pkgname=zeile
pkgver=0.5.0
pkgrel=1
pkgdesc="Small, fast GTK4 markdown viewer with live reload, themes and Mermaid support"
arch=(any)
url="https://github.com/DnaMes/zeile"
license=(GPL-3.0-or-later)
depends=(
    gtk4
    webkitgtk-6.0
    python-gobject
    python-markdown
    python-pygments
    python-nh3
    python-pymdown-extensions
)
optdepends=('mermaid-cli: render ```mermaid fences (npm install -g @mermaid-js/mermaid-cli)')
source=("$pkgname-$pkgver.tar.gz::https://github.com/DnaMes/zeile/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c01f3df4b751fb69692636fb7f555b6fe06676d64d92037d0d5fb4395e2e1632')  # v0.5.0 tag archive

package() {
    cd "$pkgname-$pkgver"
    # The layout is shared with the deb and rpm builds (and keeps the start-sequence
    # logo next to zeile.py); a package never claims the text/markdown default handler.
    packaging/stage.sh "$pkgdir" /usr
}
